# ==============================================================================
# LiteLLM Helper & Gateway Stack Configuration (.env)
# ==============================================================================

# --- 1. General & System Settings ---
# Timezone for container logs and cron scheduling
TZ=UTC

# Base persistent storage directory on host (e.g. /srv/data/ai-ui or /data/ai-ui)
WORKDIR=/srv/data/ai-ui

# --- 2. Ingress & Public Domains ---
# Public or Tailscale domain for the LiteLLM Helper Control Plane GUI
LITELLM_HELPER_DOMAIN=litellm-helper.example.com

# Public or Tailscale domain for the LiteLLM OpenAI-Compatible API Gateway
LITELLM_DOMAIN=litellm.example.com

# --- 3. LiteLLM Helper (Control Plane & Usage Analytics) ---
# Internal/Host listening port for LiteLLM Helper web UI
LITELLM_HELPER_PORT=5001

# Master admin password for LiteLLM Helper web portal & internal webhook authentication
LITELLM_HELPER_PASSWORD=change_this_to_a_secure_helper_password

# Flask session secret key (generate with: openssl rand -hex 32)
FLASK_SECRET_KEY=generate_a_32_byte_flask_secret_hex

# --- 4. Email Notification Settings (Optional) ---
# SMTP server configuration for budget alerts and key exhaustion notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=alerts@example.com
EMAIL_TO=admin@example.com

# --- 5. LiteLLM Proxy / API Gateway ---
# Host/Tailscale IP binding (0.0.0.0 or specific Tailscale IP e.g. 100.x.y.z)
LITELLM_IP=0.0.0.0
LITELLM_PORT=4000

# Master API Key for client authentication to LiteLLM (sk-...)
LITELLM_MASTER_KEY=generate_a_secure_litellm_master_key

# Concurrency & Worker Threads
LITELLM_WORKERS=4

# Timeouts in seconds for long-running LLM completions & tool calls
LITELLM_TIMEOUT=600
SERVER_TIMEOUT=600
REQUEST_TIMEOUT=600

# Optional Hugging Face Token for accessing gated model weights / tokenizers
HF_TOKEN=

# --- 6. Docker Network ---
# Shared Docker network for homelab containers (e.g. shared_net)
SHARED_NETWORK=shared_net
