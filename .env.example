# LiteLLM Helper v3 Configuration
# Copy this file to .env and set your values

# Password to access the web UI
LITELLM_HELPER_PASSWORD=your_secure_password_here

# Secret key for Flask session signing
FLASK_SECRET_KEY=your_flask_secret_key_here

# Database path (default: litellm_helper.db in the data/ directory)
# DATABASE_URL=sqlite:///data/litellm_helper.db