# LiteLLM Helper v3 Configuration
# Copy this file to .env and set your values

# Application Port (default: 5001)
PORT=5001

# Password to access the web UI
LITELLM_HELPER_PASSWORD=your_secure_password_here

# Secret key for Flask session signing
FLASK_SECRET_KEY=your_flask_secret_key_here

# Database path (default: litellm_helper.db in the data/ directory)
# DATABASE_URL=sqlite:///data/litellm_helper.db

# ========================================================
# HOST DIRECTORY SETTINGS
# ========================================================
# Base directory where all volume data will be stored on the host
WORKDIR=/home/mgrsys/DATA/var/ai-ui

# ========================================================
# OPEN-WEBUI & EXTERNAL TOOLS
# ========================================================
WEBUI_SECRET_KEY=your_webui_secret_key_here
LITELLM_MASTER_KEY=sk-your-master-key-here
QDRANT_API_KEY=your_qdrant_api_key_here

# External Tool IPs/Hostnames
SEARXNG_IP=192.168.1.100
DOCLING_IP=192.168.1.101
INFINITY_IP=192.168.1.102
INFINITY_API_KEY=your_infinity_api_key_here