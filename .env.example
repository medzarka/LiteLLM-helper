# ==============================================================================
# LiteLLM Helper, Gateway & Open-WebUI Stack Configuration
# Optimized for ARM64 (Orange Pi 5 Plus 32GB RAM / Linux)
# ==============================================================================

# --- 1. Base Storage Directory ---
WORKDIR=/srv/data/ai-ui

# --- 2. LiteLLM Helper (Control Plane & Usage Analytics) ---
LITELLM_HELPER_PORT=5001
LITELLM_HELPER_PASSWORD=change_this_to_a_secure_helper_password
FLASK_SECRET_KEY=generate_a_32_byte_flask_secret_hex

# Optional SMTP Email Alerts for Key Usage
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=alerts@example.com
EMAIL_TO=admin@example.com

# --- 3. LiteLLM Proxy / Gateway ---
# Master Key for LiteLLM routing and client authorization
LITELLM_MASTER_KEY=generate_a_secure_litellm_master_key
LITELLM_WORKERS=4
LITELLM_TIMEOUT=600
SERVER_TIMEOUT=600
REQUEST_TIMEOUT=600

# Optional Hugging Face Token for Model Downloads
HF_TOKEN=

# --- 4. Qdrant Vector Database ---
QDRANT_API_KEY=generate_a_secure_qdrant_api_key

# --- 5. Open-WebUI Chat Interface ---
WEBUI_SECRET_KEY=generate_a_secure_webui_secret_key
WEBUI_WORKERS=4

# External AI Services (Infinity, SearXNG, Docling)
INFINITY_IP=100.83.191.70
INFINITY_PORT=9999
INFINITY_API_KEY=your_infinity_api_key

SEARXNG_IP=100.83.191.70
SEARXNG_PORT=8080

DOCLING_IP=100.83.191.70
DOCLING_PORT=5501

# --- 6. Docker Network ---
SHARED_NETWORK=shared_net
