# ==============================================================================
# LiteLLM Helper & Gateway Stack Configuration
# Optimized for ARM64 (Orange Pi 5 Plus 32GB RAM / Linux)
# ==============================================================================

# --- 1. Base Storage Directory ---
WORKDIR=/srv/data/ai-ui

# --- 2. LiteLLM Helper (Control Plane & Usage Analytics) ---
LITELLM_HELPER_PORT=5001
LITELLM_HELPER_PASSWORD=change_this_to_a_secure_helper_password
FLASK_SECRET_KEY=generate_a_32_byte_flask_secret_hex

# Optional SMTP Email Alerts for Key Usage
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=alerts@example.com
EMAIL_TO=admin@example.com

# --- 3. LiteLLM Proxy / Gateway ---
# Master Key for LiteLLM routing and client authorization
LITELLM_IP=0.0.0.0
LITELLM_PORT=4000
LITELLM_MASTER_KEY=generate_a_secure_litellm_master_key
LITELLM_WORKERS=4
LITELLM_TIMEOUT=600
SERVER_TIMEOUT=600
REQUEST_TIMEOUT=600

# Optional Hugging Face Token for Model Downloads
HF_TOKEN=

# --- 4. Docker Network ---
SHARED_NETWORK=shared_net
